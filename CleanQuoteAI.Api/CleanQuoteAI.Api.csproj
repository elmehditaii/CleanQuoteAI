    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>9d2a9b94-b10c-4dc4-a175-b9277f45e175</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Anthropic" Version="12.35.1" />
